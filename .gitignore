# ── Secrets & environment ──────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Virtual environments ───────────────────────────────
venv/
env/
.venv/
.virtualenv/

# ── Python cache & build artifacts ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ── Testing & coverage ─────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
*.cover

# ── Linting / formatting / typing ──────────────────────
.mypy_cache/
.ruff_cache/
.black_cache/

# ── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_meta

# ── IDEs & editors ─────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~

# ── OS junk ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ───────────────────────────────────────────────
*.log
logs/

# ── Ollama models / large binaries (never commit) ──────
*.gguf
*.bin
*.safetensors
models/*.pt
models/*.ckpt

# ── Project-specific ───────────────────────────────────
assets/demo_recordings/
temp/
tmp/
